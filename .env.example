# === Discord credentials ===
DISCORD_TOKEN=
CLIENT_ID=
# Optional — set to a guild ID for instant slash-command updates during dev
# TEST_GUILD_ID=

# === Admin access ===
# Comma-separated Discord user IDs allowed to use /check.
# (Other admin commands — /config, /role-rewards, /bonus, /invite-labels, /export —
#  use the Manage Guild permission instead.)
ADMIN_IDS=

# === Logging ===
# DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# === Database ===
# SQLite file path. Inside Docker, /data/invites.db is mapped to a named volume.
DATABASE_PATH=./invites.db

# === i18n (global default; per-guild overrideable via /config set locale ...) ===
# en | custom
LOCALE_LANG=en

# === Validation behavior (global defaults; per-guild overrideable via /config) ===
VALIDATION_PERIOD_DAYS=7
VALIDATION_CHECK_INTERVAL_MINUTES=60

# === Anti-cheat window (global default for new guilds) ===
ANTI_CHEAT_WINDOW_DAYS=30

# === Anti-fake: minimum Discord account age in days (0 = disabled) ===
# Joins from younger accounts are flagged and earn no invite credit.
MIN_ACCOUNT_AGE_DAYS=0

# === Cleanup on guild leave ===
# If true, deletes UserInvites + TrackedJoins + JoinHistory rows when bot leaves a guild
PERFORM_GUILD_DELETE_CLEANUP=false
