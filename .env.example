# --- Discord Bot Credentials ---
# Obtained from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# --- Admin IDs ---
# Comma-separated Discord User IDs who can use the /check command
ADMIN_IDS=123456789012345678,987654321098765432

# --- Language Configuration ---
# 'en' or 'custom' (requires configured custom: block in custom-lang.yaml)
LOCALE_LANG=en

# --- Bot Customization (Optional) ---
# TEST_GUILD_ID=your_development_server_id # For instant slash command updates
# LOG_LEVEL=INFO # DEBUG, INFO, WARN, ERROR

# --- Behavioral Settings (Optional) ---
# VALIDATION_PERIOD_DAYS=7               # Days a user must stay to be "validated"
# VALIDATION_CHECK_INTERVAL_MINUTES=60   # How often to check for validations
# PERFORM_GUILD_DELETE_CLEANUP=false     # Delete data when bot leaves a guild
