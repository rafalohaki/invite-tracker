{
    "name": "invite-tracker",
    "version": "2.0.0",
    "description": "Discord invite tracking bot — TypeScript rewrite (Bun + discord.js v14)",
    "type": "module",
    "private": true,
    "license": "MIT",
    "engines": {
        "bun": ">=1.3.0"
    },
    "scripts": {
        "start": "bun src/index.ts",
        "dev": "bun --watch src/index.ts",
        "deploy:commands": "bun src/deploy-commands.ts",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "lint": "biome check src tests",
        "lint:fix": "biome check --write src tests",
        "typecheck": "tsc --noEmit",
        "audit": "bun audit",
        "verify": "bun run lint && bun run typecheck && bun run test"
    },
    "dependencies": {
        "discord.js": "~14.26.4",
        "js-yaml": "^4.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.16",
        "@types/js-yaml": "^4.0.9",
        "bun-types": "^1.3.14",
        "typescript": "^6.0.3"
    },
    "overrides": {
        "lodash": ">=4.17.24",
        "undici": ">=6.23.0"
    }
}
